# ───────── HORA MUERTA STUDIO ─────────
# Copia este archivo a .env y rellena lo que tengas.
# Cada agente funciona en MODO DEMO (simulado) si le falta su clave.

# Fuerza todo en modo demo aunque haya claves (1 = sí)
MODO_DEMO=0
PUERTO=3333

# Agentes 1, 2, 8 (Tendencias, Guion, Gerente) → Claude
ANTHROPIC_API_KEY=

# Agente 3 (Voz y Sonido) → ElevenLabs: narrador, música, efectos
ELEVENLABS_API_KEY=
# Déjalo vacío para que la app DISEÑE una voz exclusiva del canal (npm run voz:disenar)
ELEVENLABS_VOICE_ID=
# Descripción de la voz a diseñar (en inglés funciona mejor)
# VOZ_DESCRIPCION=Male narrator, deep low voice with a slight rasp, calm and intimate...
# eleven_v3 entiende etiquetas de actuación ([whispers], [sighs]…)
ELEVEN_MODELO_VOZ=eleven_v3
# ELEVEN_MODELO_MUSICA=      # vacío = modelo por defecto (music_v1 | music_v2 | music_v2_5)
# ELEVEN_MODELO_SFX=         # vacío = por defecto (eleven_text_to_sound_v2 | _v3)
AUDIO_MUSICA=1
AUDIO_EFECTOS=1
# Costos aproximados para la Tesorería (USD) — ajústalos a tu plan
ELEVEN_USD_MUSICA_MIN=0.8
ELEVEN_USD_EFECTO=0.04
# Precio aproximado por cada 1.000 caracteres (USD) para la tesorería
ELEVENLABS_USD_POR_1K=0.30

# Agente 4 (Animación) → visuales profesionales por escena
# Opción A: Higgsfield  (cloud.higgsfield.ai → API keys) formato KEY_ID:KEY_SECRET
HF_CREDENTIALS=
# HF_MODELO_IMAGEN=flux-pro/kontext/max/text-to-image
# HF_MODELO_VIDEO=/v1/image2video/dop
# HF_DOP_MODELO=dop-turbo        # dop-lite | dop-turbo | dop-standard
# Opción B: fal.ai (una sola clave para Flux, Kling, Veo, Seedance…)
FAL_KEY=
# FAL_MODELO_IMAGEN=fal-ai/flux/dev
# FAL_MODELO_VIDEO=fal-ai/kling-video/v2.5-turbo/pro/image-to-video
# imagenes = 1 imagen por escena con zoom lento (barato)
# video    = cada escena animada como clip (más profesional, más caro)
VISUAL_MODO=imagenes
# Costos aproximados para la Tesorería (USD) — ajústalos a tu plan
VISUAL_USD_IMAGEN=0.05
VISUAL_USD_CLIP=0.35

# Agente 1 (Tendencias) → radar de virales en YouTube
# Basta una API key simple (Google Cloud → Credenciales → Clave de API, con YouTube Data API v3 habilitada).
# Cada búsqueda gasta 100 de las 10.000 unidades diarias gratis (3 búsquedas por video).
YT_API_KEY=

# Agentes 6 y 7 (Subida y Datos) → YouTube Data API v3 + Analytics
# Ejecuta `npm run auth:youtube` para conseguir el refresh token
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# private | unlisted | public  (empieza en private y revisa tú)
YT_PRIVACIDAD=private

# Agente 8 (Gerente): exige tu aprobación antes de subir (muy recomendado)
REQUIERE_APROBACION=1
# Piloto automático: cuántos videos por día
VIDEOS_POR_DIA=3

# Agente 9 (Tesorería)
GASTO_MAX_DIARIO_USD=5
# RPM estimado de Shorts (USD por cada 1.000 vistas) para proyectar ingresos
RPM_SHORTS_USD=0.06

# Fuente para subtítulos / miniaturas
FUENTE=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
